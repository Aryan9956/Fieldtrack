# =====================================================================
# FIELDTRACK — PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# =====================================================================

# 1. Production PostgreSQL Database Connection String (Neon / Supabase / Railway)
DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/fieldtrack?sslmode=require"

# 2. Production Auth Secret (Must be 32+ characters, generated via openssl rand -base64 32)
AUTH_SECRET="REPLACE_WITH_HIGH_ENTROPY_RANDOM_SECRET_KEY_MIN_32_CHARS"

# 3. Production Transactional Email Service (Resend / Brevo)
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_live_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="FieldTrack <noreply@yourdomain.com>"

# 4. Commercial Pricing & Payment Processing (PAYMENTS_ENABLED="false" initially)
PRICE_PER_EMPLOYEE="19"
PAYMENTS_ENABLED="false"

# 5. Public Canonical Domain & Security Settings
NEXT_PUBLIC_APP_URL="https://fieldtrack.yourdomain.com"
NEXT_PUBLIC_APP_NAME="FieldTrack"
NEXT_PUBLIC_ENABLE_DEMO_CREDENTIALS="false"

# 6. Production Super Admin Account Configuration (For npm run create-admin)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD_123!"
ADMIN_NAME="Platform Administrator"
