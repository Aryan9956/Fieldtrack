# =====================================================================
# FIELDTRACK — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# Development (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - Neon / Supabase / Railway):
# DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/fieldtrack?sslmode=require"

# ---------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ---------------------------------------------------------------------
# Mandatory 32+ character random secret key for JWT signing.
# Generate via: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-random-secret-minimum-32-characters-long"

# ---------------------------------------------------------------------
# 3. EMAIL PROVIDER CONFIGURATION
# ---------------------------------------------------------------------
# "dev" = logs verification links to console & local dev inbox
# "resend" = uses Resend transactional email API
# "smtp" = uses SMTP server
EMAIL_PROVIDER="dev"

# Production Email Credentials (when EMAIL_PROVIDER="resend"):
# RESEND_API_KEY="re_123456789_xxxxxx"
# EMAIL_FROM="FieldTrack <noreply@yourdomain.com>"

# ---------------------------------------------------------------------
# 4. SUBSCRIPTION & PAYMENT ARCHITECTURE
# ---------------------------------------------------------------------
# Commercial Price per active employee per month in INR (₹19)
PRICE_PER_EMPLOYEE="19"

# Keep set to "false" initially (₹0 MVP Mode - Access granted manually by Super Admin)
# Set to "true" when ready to accept live online payments via Razorpay
PAYMENTS_ENABLED="false"

# Razorpay Production Keys (Required when PAYMENTS_ENABLED="true"):
# RAZORPAY_KEY_ID="rzp_live_xxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
# RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxx"

# ---------------------------------------------------------------------
# 5. PUBLIC DOMAIN & APP METADATA
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FieldTrack"

# Set to "true" ONLY in local development to display demo login quick buttons
NEXT_PUBLIC_ENABLE_DEMO_CREDENTIALS="true"

# ---------------------------------------------------------------------
# 6. INITIAL SUPER ADMIN CLI CREATION
# ---------------------------------------------------------------------
# Used by `npm run create-admin` CLI command
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ReplaceWithStrongAdminPassword123!"
ADMIN_NAME="FieldTrack Super Admin"
